{
	"name": "@carpool/api",
	"private": true,
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/copy-assets.cjs",
		"db": "tsx src/db-command.ts",
		"test:migrations": "tsx test/migrations-check.ts",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/apps/api/src/index.js",
		"test": "vitest run --pool=forks --maxWorkers=1",
		"test:browser": "vitest run --config vitest.browser.config.mts",
		"test:postgres": "tsx test/postgres-check.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit"
	},
	"packageManager": "pnpm@10.23.0",
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@types/emscripten": "^1.41.6",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.23.1",
		"playwright": "1.57.0",
		"socket.io-client": "4.8.4",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@fastify/static": "^8.3.0",
		"fastify": "^5.12.1",
		"pg": "^8.23.0",
		"socket.io": "4.8.4",
		"zod": "^4.5.4"
	}
}

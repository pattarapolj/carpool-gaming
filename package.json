{
	"name": "carpool-gaming",
	"private": true,
	"scripts": {
		"build": "pnpm --filter @carpool/api build && pnpm --filter @carpool/web build",
		"dev": "pnpm --parallel --filter @carpool/api --filter @carpool/web dev",
		"dev:web": "pnpm --filter @carpool/web dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"start": "pnpm --filter @carpool/api start",
		"test": "pnpm --recursive test",
		"test:browser": "pnpm --filter @carpool/api test:browser",
		"typecheck": "pnpm --recursive typecheck"
	},
	"packageManager": "pnpm@10.23.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.12"
	}
}
